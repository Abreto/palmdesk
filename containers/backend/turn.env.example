# Backend runtime only. Never use VITE_ names for these secrets.
TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL=3600
# Optional CNAME to turn.cloudflare.com, DNS-only. TLS keeps Cloudflare's hostname.
TURN_HOSTNAME=turn.abreto.icu

# For a future coturn deployment, change TURN_PROVIDER to coturn and set:
# COTURN_URLS=turn:turn.abreto.icu:3478?transport=udp,turns:turn.abreto.icu:5349?transport=tcp
# COTURN_AUTH_SECRET=
