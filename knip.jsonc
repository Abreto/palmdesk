{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/main.ts is found through index.html.
  "entry": [
    "electron-main/index.ts",
    "electron-main/preload.ts",
    "electron-builder.cjs",
    "scripts/*.{mjs,cjs}",
    "session-core/index.mjs",
    // The session worker is a separate Vite build input, which knip doesn't follow.
    "session-core/worker.mjs",
    "session-core/test/*.mjs",
    "test/smoke/*.{cjs,mjs}",
  ],
  "project": [
    "src/**/*.{ts,vue}",
    "electron-main/**/*.ts",
    "session-core/**/*.mjs",
    "scripts/**/*.{mjs,cjs}",
    "test/**/*.{cjs,mjs,ts}",
  ],
  // The backend container runs on the pinned upstream server's dependencies.
  "ignore": ["containers/**"],
  "ignoreDependencies": [
    // Imported from SCSS through css.preprocessorOptions in vite.config.ts.
    "billd-scss",
    // Named as a plugin in postcss.config.js.
    "postcss-preset-env",
  ],
  // Browser smoke tests import these from the Vite dev server at run time.
  "ignoreUnresolved": [
    "/src/store/network/index.ts",
    "/__qr/qr-scanner.min.js",
  ],
  // Windows-only command used by a manual native smoke test.
  "ignoreBinaries": ["taskkill.exe"],
}
